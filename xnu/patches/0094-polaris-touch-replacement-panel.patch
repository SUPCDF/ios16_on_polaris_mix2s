diff --git a/bsd/dev/polaris_touch_i2c.c b/bsd/dev/polaris_touch_i2c.c
index 442f22c..6f69ee8 100644
--- a/bsd/dev/polaris_touch_i2c.c
+++ b/bsd/dev/polaris_touch_i2c.c
@@ -388,15 +388,26 @@ pt_thread(void *arg __unused, wait_result_t result __unused)
 		printf("POLARIS I2C: bus stuck; no RMI4 transactions\n");
 		goto restore;
 	}
-	if (!pt_read(0x00e3, f01, sizeof(f01))) {
-		printf("POLARIS I2C: F01 PDT read failed stage=%u reason=%u (1=SCL,2=NACK) lines=%u%u\n",
-		    pt_read_stage, pt_read_failure, pt_high(SDA), pt_high(SCL));
-		goto restore;
+	/* Original JDI S3330 reports 2c 23; replacement panels may report a
+	 * different vendor/model (observed 2f 26). The F01 version/capability
+	 * bytes 0c 06 .. 01 are the RMI4 identity that matters. Retry once:
+	 * the first read after reset can be glitched. */
+	bool f01_ok = false;
+	for (unsigned attempt = 0; attempt < 2 && !f01_ok; ++attempt) {
+		if (!pt_read(0x00e3, f01, sizeof(f01))) {
+			printf("POLARIS I2C: F01 PDT read failed attempt=%u stage=%u reason=%u (1=SCL,2=NACK) lines=%u%u\n",
+			    attempt, pt_read_stage, pt_read_failure, pt_high(SDA), pt_high(SCL));
+			continue;
+		}
+		printf("POLARIS I2C: F01 PDT %02x %02x %02x %02x %02x %02x\n",
+		    f01[0], f01[1], f01[2], f01[3], f01[4], f01[5]);
+		f01_ok = f01[2] == 0x0c && f01[3] == 0x06 && f01[5] == 0x01;
+		if (!f01_ok) {
+			printf("POLARIS I2C: F01 vendor/model %02x %02x not accepted; retrying\n",
+			    f01[0], f01[1]);
+		}
 	}
-	printf("POLARIS I2C: F01 PDT %02x %02x %02x %02x %02x %02x\n",
-	    f01[0], f01[1], f01[2], f01[3], f01[4], f01[5]);
-	if (f01[0] != 0x2c || f01[1] != 0x23 || f01[2] != 0x0c ||
-	    f01[3] != 0x06 || f01[5] != 0x01) {
+	if (!f01_ok) {
 		printf("POLARIS I2C: F01 PDT identity mismatch; HID withheld\n");
 		goto restore;
 	}
@@ -407,8 +418,10 @@ pt_thread(void *arg __unused, wait_result_t result __unused)
 	}
 	printf("POLARIS I2C: F12 PDT %02x %02x %02x %02x %02x %02x\n",
 	    f12[0], f12[1], f12[2], f12[3], f12[4], f12[5]);
-	if (f12[0] != 0x49 || f12[1] != 0x00 || f12[2] != 0x12 ||
-	    f12[3] != 0x08 || f12[5] != 0x12) {
+	/* The first four bytes are this panel's F12 query/control/data
+	 * bases; replacement panels may use different addresses. Only the
+	 * RMI4 function number (0x12) is fixed. */
+	if (f12[5] != 0x12) {
 		printf("POLARIS I2C: F12 PDT identity mismatch; HID withheld\n");
 		goto restore;
 	}
