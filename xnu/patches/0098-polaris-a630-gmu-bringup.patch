+/* ---------------------------------------------------------------- HFI v1 */
+
+#define HFI_QUEUES              3
+#define HFI_QUEUE_SIZE          4096
+#define HFI_QUEUE_WORDS         (HFI_QUEUE_SIZE / 4)
+
+struct hfi_queue_table_header {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_q, num_active_q;
+};
+struct hfi_queue_header {
+	uint32_t status, start_addr, type, queue_size, msg_size, drop_cnt;
+	uint32_t rx_wm, tx_wm, rx_req, tx_req, read_index, write_index;
+};
+#define HFI_QUEUE_SLOTS         17
+struct hfi_queue_table {
+	struct hfi_queue_table_header qtbl_hdr;
+	struct hfi_queue_header qhdr[HFI_QUEUE_SLOTS];
+};
+
+/* The vendor table has 17 queue-header slots even when only 3 are active;
+ * the GMU walks all of them.  Queue data starts after the 16-byte-aligned
+ * table, one 4 KiB page apart. */
+#define HFI_QUEUE_OFFSET(i) (((sizeof(struct hfi_queue_table) + 15) & ~15ull) + (i) * HFI_QUEUE_SIZE)
+
+struct hfi_msg_hdr {
