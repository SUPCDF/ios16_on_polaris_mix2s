+/* ---------------------------------------------------------------- SMMU */
+
+#define PTE_VALID       (1ull << 0)
+#define PTE_TABLE       (1ull << 1)
+#define PTE_AP_UNPRIV   (1ull << 6)
+#define PTE_AP_RO       (1ull << 7)
+#define PTE_SH_OUTER    (2ull << 8)
+#define PTE_AF          (1ull << 10)
+#define PTE_NOT_GLOBAL  (1ull << 11)
+/* Privileged by default (the GMU's requests are); the 3D core adds AP_UNPRIV. */
+#define PTE_PAGE        (PTE_VALID | PTE_TABLE | PTE_SH_OUTER | PTE_AF | PTE_NOT_GLOBAL)
+
+#define SMMU_CB(n)      (0x8000u + 0x1000u * (n))   /* ARM SMMU-500: context banks are one page apart */
+#define SMMU_CBAR(n)    (0x1000u + 4u * (n))
+#define SMMU_CBA2R(n)   (0x1800u + 4u * (n))
+#define SMMU_SMR(n)     (0x0800u + 4u * (n))
+#define SMMU_S2CR(n)    (0x0c00u + 4u * (n))
+
+#define SMMU_CB_SCTLR   0x000
+#define SMMU_CB_TCR2    0x010
+#define SMMU_CB_TTBR0   0x020
+#define SMMU_CB_TCR     0x030
+#define SMMU_CB_MAIR0   0x038
+#define SMMU_CB_MAIR1   0x03c
+#define SMMU_CB_FSR     0x058
+#define SMMU_CB_FAR     0x060
+#define SMMU_CB_FSYNR0  0x068
+#define SMMU_CB_TLBIALL 0x618
+#define SMMU_CB_TLBSYNC 0x7f0
+#define SMMU_CB_TLBSTATUS 0x7f4
