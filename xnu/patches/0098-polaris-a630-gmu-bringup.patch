+/*
+ * polaris: the Adreno 630 of the Xiaomi Mi MIX 2S (SDM845 v2, A630v2) for
+ * programs to draw with, behind the hardware interface (redwood_gpu_*) that
+ * RedwoodGPU.cpp's msm DRM user client speaks (from vcvkk/darwin-redwood,
+ * HackiOS; reused with the author's permission).
+ *
+ * Stage 1 (this revision): GPUCC/GMU/HFI/SMMU bring-up and readback only.
+ * It does not submit a command buffer, does not touch the CPU framebuffer and
+ * does not publish RedwoodGPU.  Stage 2 adds PAS13/zap, SQE/CP and the
+ * userland Mesa/EAGL path.
+ *
+ * Hardware references, in order of use:
+ *   - MiCode polaris-o-oss gpucc-sdm845.c (v2 clock tables, GDSCs)
+ *   - MiCode kgsl_gmu.c / adreno_a6xx.c (TCM_BOOT, RSC/PDC, HFI v1)
+ *   - HackiOS redwood_adreno.c (staged ownership/rollback shape)
+ *   - mainline Linux a6xx_hfi.c (A630 fixed DDR/CNOC fallback table)
+ *
+ * A630 GMU registers are addressed by their byte offset from GMU_BASE
+ * (0x0506a000).  The vendor's a6xx_reg.h offsets are relative to the GPU
+ * register base 0x05000000; subtracting 0x1a800 words converts them.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+#include <pexpert/pexpert.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <libkern/libkern.h>
+#include <string.h>
+
+extern "C" {
+vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+uint64_t kvtophys(vm_offset_t va);
+int polaris_fw_read(const char *path, void **data, size_t *size);
+void polaris_fw_free(void *data, size_t size);
+int polaris_root_mounted(void);
+void polaris_adreno_init(void);
+
+bool redwood_gpu_ready(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t redwood_gpu_address(uint64_t size);
+void redwood_gpu_address_free(uint64_t address, uint64_t size);
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void redwood_gpu_mapped(void);
+void redwood_gpu_unmap(uint64_t address, uint64_t size);
+void redwood_gpu_to_memory(void *start, uint64_t size);
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool redwood_gpu_done(uint32_t fence);
+uint32_t redwood_gpu_last(void);
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void redwood_gpu_report(const char *why);
+void redwood_gpu_stop(void);
+void redwood_tl(const char *format, ...) __printflike(1, 2);
+uint32_t gpu_log;
+}
