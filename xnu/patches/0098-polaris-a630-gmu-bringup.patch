+/* ---------------------------------------------------------------- MMIO */
+
+static inline uint32_t rd(volatile uint8_t *b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+}
+static inline void rmw(volatile uint8_t *b, uint32_t o, uint32_t clr, uint32_t set) { wr(b, o, (rd(b, o) & ~clr) | set); }
+static inline void gpu_wr(uint32_t reg, uint32_t v) { wr(gpu, 4 * reg, v); }
+static inline uint32_t gpu_rd(uint32_t reg) { return rd(gpu, 4 * reg); }
+static inline void gpu_wr64(uint32_t reg, uint64_t v) { gpu_wr(reg, (uint32_t)v); gpu_wr(reg + 1, (uint32_t)(v >> 32)); }
+
+static bool
+poll(volatile uint8_t *b, uint32_t o, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t i = 0; i <= us; i++) {
+		if ((rd(b, o) & mask) == want) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+/* The raw host/GMU register mirrors the host's own SET/CLR writes, so it
+ * cannot be used as an acknowledge.  Only GMU2HOST_INTR_INFO is the GMU's
+ * response; the caller still checks the rail state afterwards. */
+static bool
+oob_poll(uint32_t bit)
+{
+	return poll(gmu, GMU_GMU2HOST_INTR_INFO, bit, bit, 100000);
+}
+
+static void
+dcache_sync(void *start, uint64_t size)
+{
+	uintptr_t p = (uintptr_t)start & ~(uintptr_t)63;
+	uintptr_t end = (uintptr_t)start + size;
+
+	for (; p < end; p += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---------------------------------------------------------------- memory below 4 GiB */
+
+static bool
+kbuf_alloc(struct kbuf *b, uint64_t size)
+{
+	size = (size + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
+	b->md = NULL;
+	/*
+	 * Pass NULL for the physical address: with a non-NULL pointer
+	 * IOMallocContiguous falls back to inTaskWithPhysicalMask(), whose low
+	 * memory pool is below phys_base and panics in physToKV_range().  The
+	 * NULL path uses kmem_alloc_contig() in the managed kernel map.
+	 */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+	b->va = (uint8_t *)IOMallocContiguous((vm_size_t)size, PAGE_SIZE, NULL);
+#pragma clang diagnostic pop
+	if (b->va == NULL) {
+		return false;
+	}
+	b->pa = (uint64_t)kvtophys((vm_offset_t)b->va);
+	b->size = size;
+	bzero(b->va, size);
+	return true;
+}
+
+/* ---------------------------------------------------------------- clocks and CX */
+
+static bool
+branch_on(volatile uint8_t *b, uint32_t o, const char *name, bool must)
+{
+	rmw(b, o, 0, CBCR_EN);
+	if (!(rd(b, o) & CBCR_OFF) || poll(b, o, CBCR_OFF, 0, 1000)) {
+		return true;
+	}
+	IOLog("POLARIS GPU: %s stays off (%08x)%s\n", name, rd(b, o), must ? "" : "; status unreliable, going on");
+	return !must;
+}
+
+static bool
+rcg_set(uint32_t cmd, uint32_t src, uint32_t div)
+{
+	wr(gpucc, cmd + 4, (src << 8) | (2 * div - 1));
+	rmw(gpucc, cmd, 0, RCG_UPDATE);
+	if (!poll(gpucc, cmd, RCG_UPDATE, 0, 500)) {
+		IOLog("POLARIS GPU: rcg %08x does not update (%08x)\n", cmd, rd(gpucc, cmd));
+		return false;
+	}
+	return true;
+}
+
+static bool
+cx_on(void)
+{
+	uint32_t gdscr = rd(gpucc, GPUCC_CX_GDSCR);
+	uint32_t hw = rd(gpucc, GPUCC_CX_HW_CTRL);
+
+	if ((gdscr | hw) & GDSC_PWR_ON) {
+		return true;
+	}
+	if (gdscr & GDSC_HW_CONTROL) {
+		IOLog("POLARIS GPU: CX GDSC under HW control and off (GDSCR %08x HW %08x)\n", gdscr, hw);
+		return false;
+	}
+	wr(gpucc, GPUCC_CX_GDSCR, gdscr & ~GDSC_COLLAPSE);
+	if (!poll(gpucc, GPUCC_CX_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, 500)) {
+		IOLog("POLARIS GPU: CX GDSC no PWR_ON (GDSCR %08x HW %08x)\n",
+		    rd(gpucc, GPUCC_CX_GDSCR), rd(gpucc, GPUCC_CX_HW_CTRL));
+		return false;
+	}
+	return true;
+}
+
+static bool
+gx_on(void)
+{
+	uint32_t gdscr = rd(gpucc, GPUCC_GX_GDSCR);
+
+	if (gdscr & (1u << 27)) {
+		return true;
+	}
+	wr(gpucc, GPUCC_GX_GDSCR, gdscr & ~GDSC_COLLAPSE);
+	if (!poll(gpucc, GPUCC_GX_GDSCR, 1u << 27, 1u << 27, 500)) {
+		IOLog("POLARIS GPU: GX GDSC no PWR_ON (GDSCR %08x)\n", rd(gpucc, GPUCC_GX_GDSCR));
+		return false;
+	}
+	return true;
+}
+
+static bool
+power_up(void)
+{
+	if (!branch_on(gcc, GCC_GPU_CFG_AHB_CBCR, "gcc_gpu_cfg_ahb", true)) {
+		return false;
+	}
+	rmw(gcc, GCC_PLL_VOTE, 0, (1u << 15) | (1u << 16));      /* GPLL0 and its /2 tap */
+	IODelay(500);
+	branch_on(gcc, GCC_GPU_MEMNOC_GFX_CBCR, "gcc_gpu_memnoc_gfx", false);
+	branch_on(gcc, GCC_GPU_SNOC_DVM_GFX_CBCR, "gcc_gpu_snoc_dvm_gfx", true);
+	branch_on(gcc, GCC_DDRSS_GPU_AXI_CBCR, "gcc_ddrss_gpu_axi", false);
+
+	if (!cx_on()) {
+		return false;
+	}
+	if (!rcg_set(GPUCC_GMU_RCGR, SRC_GPLL0, 3)) {             /* 600 MHz / 3 = 200 MHz */
+		return false;
+	}
+	branch_on(gpucc, GPUCC_CX_APB_CBCR, "gpucc_cx_apb", false);
+	branch_on(gpucc, GPUCC_CX_SNOC_DVM_CBCR, "gpucc_cx_snoc_dvm", false);
+	branch_on(gpucc, GPUCC_CRC_AHB_CBCR, "gpucc_crc_ahb", false);
+	branch_on(gpucc, GPUCC_CXO_CBCR, "gpucc_cxo", true);
+	rmw(gpucc, GPUCC_CX_GMU_CBCR, 0xff0, 0xff0);              /* wake/sleep fields */
+	if (!branch_on(gpucc, GPUCC_CX_GMU_CBCR, "gpucc_cx_gmu", true)) {
+		return false;
+	}
+	if (!gx_on()) {
+		return false;
+	}
+	rmw(gpucc, GPUCC_GX_GMU_CBCR, 0xff0, 0xff0);            /* wake/sleep fields */
+	(void)branch_on(gpucc, GPUCC_GX_GMU_CBCR, "gpucc_gx_gmu", true);
+	(void)rcg_set(GPUCC_GX_GFX3D_RCGR, SRC_GPLL0, 2);
+	rmw(gpucc, GPUCC_GX_GFX3D_CBCR, 0xff0, 0xff0);           /* wake/sleep fields */
+	(void)branch_on(gpucc, GPUCC_GX_GFX3D_CBCR, "gpucc_gx_gfx3d", true);
+
+	IOLog("POLARIS GPU: clocks: CX_GDSCR %08x CX_HW %08x CX_GMU %08x GMU_RCGR %08x GX_GDSCR %08x\n",
+	    rd(gpucc, GPUCC_CX_GDSCR), rd(gpucc, GPUCC_CX_HW_CTRL), rd(gpucc, GPUCC_CX_GMU_CBCR),
+	    rd(gpucc, GPUCC_GMU_RCGR), rd(gpucc, GPUCC_GX_GDSCR));
+	return true;
+}
+
+/* ---------------------------------------------------------------- command-db ARC */
+
+static uint32_t
+arc_word(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint8_t
+arc_byte(vm_offset_t base, uint32_t off)
+{
+	return (uint8_t)(arc_word(base, off & ~3u) >> (8u * (off & 3u)));
+}
+
+static uint16_t
+arc_half(vm_offset_t base, uint32_t off)
+{
+	return (uint16_t)arc_byte(base, off) | ((uint16_t)arc_byte(base, off + 1u) << 8);
+}
+
+static bool
+arc_id(vm_offset_t base, uint32_t entry, const char *name)
+{
+	unsigned length = 0;
+
+	while (length <= 8 && name[length] != 0) {
+		length++;
+	}
+	if (length > 8) {
+		return false;
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		uint8_t expected = i < length ? (uint8_t)name[i] : 0;
+		if (arc_byte(base, entry + i) != expected) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+arc_map(void)
+{
+	vm_offset_t locator;
+	uint32_t pa, size;
+
+	if (arc_db != 0) {
+		return true;
+	}
+	locator = ml_io_map(0x0c3f0000, 0x1000);
+	if (locator == 0) {
+		return false;
+	}
+	pa = arc_word(locator, 0x0c);
+	size = arc_word(locator, 0x10);
+	if (pa < 0x80000000 || size < 144 || size > 0x10000) {
+		IOLog("POLARIS GPU: ARC locator invalid pa %08x size %u\n", pa, size);
+		return false;
+	}
+	arc_db = ml_io_map(pa, 0x1000);
+	if (arc_db == 0 || arc_word(arc_db, 4) != 0x0c0330db) {
+		IOLog("POLARIS GPU: ARC DB mapping/magic failed\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+arc_parse(const char *name, struct arc_levels *out)
+{
+	out->count = 0;
+	if (!arc_map()) {
+		return false;
+	}
+	for (unsigned slot = 0; slot < 8; slot++) {
+		uint32_t h = 8 + slot * 16;
+		uint32_t slave = arc_half(arc_db, h);
+		uint32_t head, aux, n;
+
+		if (slave == 0) {
+			break;
+		}
+		head = 144 + arc_half(arc_db, h + 2);
+		aux = 144 + arc_half(arc_db, h + 4);
+		n = arc_half(arc_db, h + 6);
+		if (n > 512 || head + n * 24 > 0x1000) {
+			continue;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			uint32_t e = head + i * 24;
+			uint32_t len, off, start;
+
+			if (!arc_id(arc_db, e, name)) {
+				continue;
+			}
+			len = arc_half(arc_db, e + 20);
+			off = arc_half(arc_db, e + 22);
+			start = aux + off;
+			if (len < 2 || len > 32 || start + len > 0x1000) {
+				return false;
+			}
+			for (unsigned j = 0; j < len / 2; j++) {
+				uint16_t v = arc_half(arc_db, start + 2 * j);
+				if (v == 0) {
+					continue;
+				}
+				if (out->count != 0 && v <= out->level[out->count - 1]) {
+					break;
+				}
+				if (out->count < 16) {
+					out->level[out->count++] = v;
+				}
+			}
+			return out->count != 0;
+		}
+	}
+	return false;
+}
+
+static uint32_t
+arc_vote(uint16_t level, const struct arc_levels *pri, const struct arc_levels *sec, bool *ok)
+{
+	unsigned at = 0, with = 0;
+
+	*ok = false;
+	if (level <= 1) {                                       /* OFF */
+		*ok = true;
+		return 0;
+	}
+	while (at < pri->count && pri->level[at] < level) {
+		at++;
+	}
+	if (at == pri->count) {
+		return 0;
+	}
+	while (with + 1 < sec->count && sec->level[with] < pri->level[at]) {
+		with++;
+	}
+	*ok = true;
+	return ((uint32_t)pri->level[at] << 16) | ((uint32_t)with << 8) | at;
+}
+
+static void
+arc_init(void)
+{
+	static const uint16_t fallback[] = { 49, 65, 129, 193, 257, 321, 385, 417 };
+
+	if (!arc_parse("gfx.lvl", &gfx_levels)) {
+		IOLog("POLARIS GPU: ARC gfx.lvl unreadable; using standard SDM845 levels\n");
+		gfx_levels.count = sizeof(fallback) / sizeof(fallback[0]);
+		for (unsigned i = 0; i < gfx_levels.count; i++) {
+			gfx_levels.level[i] = fallback[i];
+		}
+	}
+	if (!arc_parse("mx.lvl", &mx_levels)) {
+		IOLog("POLARIS GPU: ARC mx.lvl unreadable; using standard SDM845 levels\n");
+		mx_levels.count = sizeof(fallback) / sizeof(fallback[0]);
+		for (unsigned i = 0; i < mx_levels.count; i++) {
+			mx_levels.level[i] = fallback[i];
+		}
+	}
+	IOLog("POLARIS GPU: ARC gfx %u levels, mx %u levels\n", gfx_levels.count, mx_levels.count);
+}
+
+static void
+dump_arc(const char *tag)
+{
+	static const uint16_t probes[] = { 1, 49, 65, 129, 193, 257, 321, 385, 417 };
+
+	if (!gpu_dump) {
+		return;
+	}
+	for (unsigned i = 0; i < gfx_levels.count; i++) {
+		IOLog("POLARIS GPU: ARC[%s] gfx[%u]=%u\n", tag, i, gfx_levels.level[i]);
+	}
+	for (unsigned i = 0; i < mx_levels.count; i++) {
+		IOLog("POLARIS GPU: ARC[%s] mx[%u]=%u\n", tag, i, mx_levels.level[i]);
+	}
+	for (unsigned i = 0; i < sizeof(probes) / sizeof(probes[0]); i++) {
+		bool ok;
+		uint32_t vote = arc_vote(probes[i], &gfx_levels, &mx_levels, &ok);
+		IOLog("POLARIS GPU: ARC[%s] vote level=%u raw=%08x gx=%u mx=%u ok=%d\n",
+		    tag, probes[i], vote, vote & 0xff, (vote >> 8) & 0xff, ok);
+	}
+}
+
+/* ---------------------------------------------------------------- SMMU tables */
+
+struct table { uint64_t *va; uint64_t pa; };
+static struct table l1, l2[4];
+static struct table *l3[2048];
+static struct kbuf table_chunk;
+static uint32_t table_chunk_used = 4;
+static bool tables_dirty;
+
+static bool
+table_alloc(struct table *t)
+{
+	if (table_chunk_used == PAGE_SIZE / 4096) {
+		struct kbuf b = {};
+		if (!kbuf_alloc(&b, PAGE_SIZE)) {
+			return false;
+		}
+		table_chunk = b;
+		table_chunk_used = 0;
+	}
+	t->va = (uint64_t *)(table_chunk.va + 4096 * table_chunk_used);
+	t->pa = table_chunk.pa + 4096 * table_chunk_used;
+	table_chunk_used++;
+	return true;
+}
+
+static uint64_t *
+l3_for(uint64_t va, bool create)
+{
+	uint32_t i1 = (uint32_t)(va >> 30), i2 = (uint32_t)((va >> 21) & 511), i3 = (uint32_t)(va >> 21);
+
+	if (i1 >= 4 || l1.va == NULL) {
+		return NULL;
+	}
+	if (l2[i1].va == NULL) {
+		if (!create || !table_alloc(&l2[i1])) {
+			return NULL;
+		}
+		l1.va[i1] = l2[i1].pa | PTE_VALID | PTE_TABLE;
+	}
+	if (l3[i3] == NULL) {
+		struct table *t = (struct table *)IOMalloc(sizeof(*t));
+		if (!create || t == NULL || !table_alloc(t)) {
+			if (t != NULL) {
+				IOFree(t, sizeof(*t));
+			}
+			return NULL;
+		}
+		l3[i3] = t;
+		l2[i1].va[i2] = t->pa | PTE_VALID | PTE_TABLE;
+	}
+	return l3[i3]->va;
+}
+
+/* A context bank starts one SMMU page after the previous one; the number of
+ * pages before the first context comes from IDR1, as in HackiOS' smmu_layout. */
+static uint32_t
+smmu_cb(unsigned n)
+{
+	return smmu_pages * smmu_page + n * smmu_page;
+}
+
+static uint32_t
+smmu_cbar(unsigned n)
+{
+	return smmu_page + 4 * n;
+}
+
+static uint32_t
+smmu_cba2r(unsigned n)
+{
+	return smmu_page + 0x800 + 4 * n;
+}
+
+static void
+smmu_read_layout(void)
+{
+	uint32_t idr0 = rd(smmu, 0x20), idr1 = rd(smmu, 0x24);
+
+	smmu_page = (idr1 & (1u << 31)) ? 0x10000 : 0x1000;
+	smmu_pages = 2u << ((idr1 >> 28) & 7);
+	smmu_contexts = idr1 & 0xff;
+	smmu_matches = idr0 & 0xff;
+	if (smmu_contexts == 0 || smmu_contexts > 128) {
+		smmu_contexts = 8;
+	}
+	if (smmu_matches == 0 || smmu_matches > 128) {
+		smmu_matches = 16;
+	}
+	IOLog("POLARIS GPU: SMMU layout page=%x pages=%u contexts=%u matches=%u cb0=%x cb1=%x idr0=%08x idr1=%08x idr2=%08x idr7=%08x\n",
+	    smmu_page, smmu_pages, smmu_contexts, smmu_matches, smmu_cb(0), smmu_cb(1),
+	    idr0, idr1, rd(smmu, 0x28), rd(smmu, 0x3c));
+}
+
+static void
+smmu_dump(const char *tag)
+{
+	if (!gpu_dump) {
+		return;
+	}
+	smmu_read_layout();
+	IOLog("POLARIS GPU: SMMU[%s] scr0=%08x sgfsr=%08x\n", tag, rd(smmu, 0x0), rd(smmu, 0x48));
+	for (unsigned i = 0; i < smmu_matches; i++) {
+		IOLog("POLARIS GPU: SMMU[%s] SMR[%u]=%08x S2CR[%u]=%08x\n",
+		    tag, i, rd(smmu, SMMU_SMR(i)), i, rd(smmu, SMMU_S2CR(i)));
+	}
+	for (unsigned i = 0; i < smmu_contexts && i < 8; i++) {
+		IOLog("POLARIS GPU: SMMU[%s] CBAR[%u]=%08x CBA2R[%u]=%08x\n",
+		    tag, i, rd(smmu, smmu_cbar(i)), i, rd(smmu, smmu_cba2r(i)));
+	}
+	for (unsigned i = 0; i < smmu_contexts && i < 8; i++) {
+		uint32_t cb = smmu_cb(i);
+		IOLog("POLARIS GPU: SMMU[%s] CB%u base=%05x sctlr=%08x ttbr0=%08x%08x tcr=%08x tcr2=%08x mair0=%08x fsr=%08x far=%08x%08x fsynr=%08x\n",
+		    tag, i, cb, rd(smmu, cb + SMMU_CB_SCTLR),
+		    rd(smmu, cb + SMMU_CB_TTBR0 + 4), rd(smmu, cb + SMMU_CB_TTBR0),
+		    rd(smmu, cb + SMMU_CB_TCR), rd(smmu, cb + SMMU_CB_TCR2),
+		    rd(smmu, cb + SMMU_CB_MAIR0), rd(smmu, cb + SMMU_CB_FSR),
+		    rd(smmu, cb + SMMU_CB_FAR + 4), rd(smmu, cb + SMMU_CB_FAR),
+		    rd(smmu, cb + SMMU_CB_FSYNR0));
+	}
+}
+
+/* Write every SMR/S2CR candidate and report which ones the hardware keeps.
+ * This is the one experiment that tells us whether the global stream table is
+ * writable, and under which sCR0 state. */
+static void
+smr_probe(void)
+{
+	static uint32_t save_smr[128], save_s2cr[128];
+	uint32_t scr0 = rd(smmu, 0x0);
+	unsigned n = smmu_matches;
+
+	for (unsigned i = 0; i < n; i++) {
+		save_smr[i] = rd(smmu, SMMU_SMR(i));
+		save_s2cr[i] = rd(smmu, SMMU_S2CR(i));
+	}
+	/* The bootloader's SMR table is often write-protected (qcom,skip-init).
+	 * Find the entry that already matches the GMU's stream 5; we only need
+	 * to repoint its S2CR at context 1. */
+	smmu_orig_valid = false;
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t smr = save_smr[i];
+		if ((smr & (1u << 31)) == 0) {
+			continue;
+		}
+		uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if ((5 & ~mask) == (id & ~mask)) {
+			if (gpu_dump) {
+				IOLog("POLARIS GPU: SMR original[%u]=%08x S2CR=%08x matches stream 5 mask=%03x\n",
+				    i, smr, save_s2cr[i], mask);
+			}
+			if (!smmu_orig_valid) {
+				smmu_orig_match = i;
+				smmu_orig_mask = mask;
+				smmu_orig_valid = true;
+			}
+		}
+	}
+	if (!smmu_orig_valid && gpu_dump) {
+		IOLog("POLARIS GPU: no bootloader SMR entry matches stream 5\n");
+	}
+	if (gpu_dump) {
+		for (unsigned exid = 0; exid < 2; exid++) {
+			for (int cp = 1; cp >= 0; cp--) {
+				uint32_t s = (scr0 & ~((1u << 0) | (1u << 3))) |
+				    (exid ? (1u << 3) : 0) | (cp ? 1u : 0);
+				unsigned ok = 0, first = 0, firstmask = 0;
+
+				wr(smmu, 0x0, s);
+				for (unsigned m = 0; m < n; m++) {
+					for (unsigned mi = 0; mi < 2; mi++) {
+						uint32_t mask = mi ? 0x400 : 0;
+						uint32_t smr, s2cr;
+						wr(smmu, SMMU_S2CR(m), 1);
+						wr(smmu, SMMU_SMR(m), (1u << 31) | (mask << 16) | 5);
+						smr = rd(smmu, SMMU_SMR(m));
+						s2cr = rd(smmu, SMMU_S2CR(m));
+						if ((smr & 0x7fff) == 5 && (s2cr & 0xff) == 1) {
+							if (ok == 0) {
+								first = m;
+								firstmask = mask;
+							}
+							ok++;
+						}
+					}
+				}
+				IOLog("POLARIS GPU: SMR probe exid=%u clientpd=%u ok=%u first_match=%u mask=%03x\n",
+				    exid, (unsigned)cp, ok, first, firstmask);
+				if (ok != 0 && first >= 1) {
+					smmu_probe_match = first;
+					smmu_probe_mask = firstmask;
+					smmu_probe_exid = exid != 0;
+					smmu_probe_clientpd = cp != 0;
+				}
+				if (cp == 0) {
+					break;
+				}
+			}
+		}
+	}
+	if (smmu_orig_valid) {
+		smmu_probe_match = smmu_orig_match;
+		smmu_probe_mask = smmu_orig_mask;
+		if (gpu_dump) {
+			IOLog("POLARIS GPU: using bootloader SMR match=%u mask=%03x\n",
+			    smmu_probe_match, smmu_probe_mask);
+		}
+	}
+	wr(smmu, 0x0, scr0);
+	for (unsigned i = 0; i < n; i++) {
+		wr(smmu, SMMU_SMR(i), save_smr[i]);
+		wr(smmu, SMMU_S2CR(i), save_s2cr[i]);
+	}
+	if (gpu_dump) {
+		IOLog("POLARIS GPU: SMR chosen match=%u mask=%03x exid=%u clientpd=%u\n",
+		    smmu_probe_match, smmu_probe_mask, smmu_probe_exid, smmu_probe_clientpd);
+	}
+}
+
+static void
+tlb_flush_ctx(unsigned ctx)
+{
+	uint32_t cb = smmu_cb(ctx);
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(smmu, cb + SMMU_CB_TLBIALL, 0);
+	wr(smmu, cb + SMMU_CB_TLBSYNC, 0);
+	poll(smmu, cb + SMMU_CB_TLBSTATUS, 1, 0, 1000);
+}
+
+static void
+tlb_flush(void)
+{
+	tlb_flush_ctx(0);
+}
+
+static bool
+mmu_map(uint64_t va, uint64_t pa, bool ro, bool core)
+{
+	uint64_t *t = l3_for(va, true);
+	if (t == NULL) {
+		return false;
+	}
+	t[(va >> 12) & 511] = pa | PTE_PAGE | (core ? PTE_AP_UNPRIV : 0) |
+	    (ro ? PTE_AP_RO : 0);
+	tables_dirty = true;
+	return true;
+}
+
+static void
+smmu_fault(const char *tag)
+{
+	IOLog("POLARIS GPU: [%s] SMMU gfsr %08x CB0 FSR %08x FAR %08x%08x CB1 FSR %08x FAR %08x%08x\n",
+	    tag, rd(smmu, 0x48), rd(smmu, smmu_cb(0) + SMMU_CB_FSR),
+	    rd(smmu, smmu_cb(0) + SMMU_CB_FAR + 4), rd(smmu, smmu_cb(0) + SMMU_CB_FAR),
+	    rd(smmu, smmu_cb(1) + SMMU_CB_FSR),
+	    rd(smmu, smmu_cb(1) + SMMU_CB_FAR + 4), rd(smmu, smmu_cb(1) + SMMU_CB_FAR));
+}
+
+static bool
+smmu_tables_init(void)
+{
+	if (l1.va == NULL && !table_alloc(&l1)) {
+		return false;
+	}
+	return true;
+}
+
+/* IOMallocContiguous memory is cacheable; the SMMU walks with non-cacheable
+ * descriptors, so every table has to reach memory before the walk starts. */
+static void
+smmu_tables_sync(void)
+{
+	if (l1.va != NULL) {
+		dcache_sync(l1.va, 4096);
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (l2[i].va != NULL) {
+			dcache_sync(l2[i].va, 4096);
+		}
+	}
+	for (unsigned i = 0; i < 2048; i++) {
+		if (l3[i] != NULL) {
+			dcache_sync(l3[i]->va, 4096);
+		}
+	}
+}
+
+static bool
+smmu_context_on(unsigned ctx, unsigned stream, unsigned match, unsigned mask, uint32_t sctlr)
+{
+	uint32_t cb = smmu_cb(ctx);
+	uint64_t root = l1.pa | ((uint64_t)ctx << 48);
+
+	wr(smmu, cb + SMMU_CB_SCTLR, 0);
+	wr(smmu, cb + SMMU_CB_FSR, 0xc00001fe);
+	wr(smmu, smmu_cba2r(ctx), 1);
+	wr(smmu, smmu_cbar(ctx), 0x0001f300);
+	wr(smmu, cb + SMMU_CB_TTBR0, (uint32_t)root);
+	wr(smmu, cb + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+	wr(smmu, cb + SMMU_CB_TCR2, 0x00038011);
+	wr(smmu, cb + SMMU_CB_TCR, 32 | (1u << 23));
+	wr(smmu, cb + SMMU_CB_MAIR0, 0xf404ff44);
+	wr(smmu, cb + SMMU_CB_MAIR1, 0);
+	wr(smmu, cb + SMMU_CB_TLBIALL, 0);
+	wr(smmu, cb + SMMU_CB_TLBSYNC, 1);
+	if (!poll(smmu, cb + SMMU_CB_TLBSTATUS, 1, 0, 1000)) {
+		IOLog("POLARIS GPU: SMMU CB%u TLB sync stuck (%08x)\n", ctx, rd(smmu, cb + SMMU_CB_TLBSTATUS));
+		return false;
+	}
+	/* The stream table must be written while this context is still off:
+	 * once SCTLR.M is set, this SMMU ignores further SMR writes. */
+	wr(smmu, SMMU_S2CR(match), ctx);
+	wr(smmu, SMMU_SMR(match), (1u << 31) | (mask << 16) | stream);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(smmu, cb + SMMU_CB_SCTLR, sctlr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	if ((rd(smmu, cb + SMMU_CB_SCTLR) & 1) == 0 ||
+	    (rd(smmu, SMMU_S2CR(match)) & 0xff) != ctx ||
+	    (rd(smmu, SMMU_SMR(match)) & 0x7fff) != stream) {
+		IOLog("POLARIS GPU: SMMU CB%u/stream %u did not take (SCTLR %08x S2CR %08x SMR %08x)\n",
+		    ctx, stream, rd(smmu, cb + SMMU_CB_SCTLR), rd(smmu, SMMU_S2CR(match)),
+		    rd(smmu, SMMU_SMR(match)));
+		return false;
+	}
+	IOLog("POLARIS GPU: SMMU CB%u stream %u match %u on, TTBR0 %08x%08x\n", ctx, stream, match,
+	    rd(smmu, cb + SMMU_CB_TTBR0 + 4), rd(smmu, cb + SMMU_CB_TTBR0));
+	return true;
+}
+
+static bool
+smmu_setup(void)
+{
+	uint32_t scr0 = rd(smmu, 0x0);
+	uint32_t idr0;
+
+	smmu_read_layout();
+	idr0 = rd(smmu, 0x20);
+	if (gpu_dump) {
+		smmu_dump("before");
+	}
+	smr_probe();
+	if ((idr0 & (1u << 8)) == 0) {
+		/* This SMMU has 8-bit stream IDs; the 0x400 mask is out of range. */
+		smmu_probe_mask = 0;
+	}
+
+	smmu_tables_sync();
+
+	/* Program the SMR/S2CR table with the client port in the state the
+	 * probe found writable.  The bootloader leaves some entries valid, and
+	 * this SMMU ignores SMR writes made while clients are enabled. */
+	scr0 &= ~((1u << 0) | (1u << 10) | (1u << 13) | (3u << 14));
+	scr0 |= (1u << 1) | (1u << 2) | (1u << 4) | (1u << 5) |
+	    (1u << 11) | (1u << 12);
+	if (smmu_probe_exid || (idr0 & (1u << 8))) {
+		scr0 |= (1u << 3);                              /* EXIDENABLE: 16-bit stream IDs */
+	}
+	wr(smmu, 0x0, scr0 | (smmu_probe_clientpd ? 1u : 0u));
+	for (unsigned i = 0; i < smmu_matches; i++) {
+		wr(smmu, SMMU_S2CR(i), 1u << 16);               /* bypass */
+	}
+	if (!smmu_orig_valid) {
+		for (unsigned i = 0; i < smmu_matches; i++) {
+			wr(smmu, SMMU_SMR(i), 0);
+		}
+	}
+	if (!smmu_context_on(0, 0, 0, 1, 0x67) ||
+	    !smmu_context_on(1, 5, smmu_probe_match, smmu_probe_mask, 0x1027)) {
+		return false;
+	}
+	wr(smmu, 0x0, scr0 & ~1u);                              /* CLIENTPD = 0 */
+	IOLog("POLARIS GPU: SMMU sCR0 %08x IDR0 %08x IDR1 %08x IDR2 %08x\n",
+	    rd(smmu, 0x0), idr0, rd(smmu, 0x24), rd(smmu, 0x28));
+	if (gpu_dump) {
+		smmu_dump("after");
+	}
+	return true;
+}
+
+static bool
+kbuf_map(struct kbuf *b, bool core)
+{
+	if (b->iova == 0) {
+		b->iova = kernel_va_next;
+		kernel_va_next += b->size + 4096;
+	}
+	for (uint64_t off = 0; off < b->size; off += 4096) {
+		if (!mmu_map(b->iova + off, b->pa + off, false, core)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- GPU VA allocator (from darwin-redwood) */
+
+static struct { uint64_t start, size; } va_free[1024];
+static unsigned va_free_count;
+
+uint64_t
+redwood_gpu_address(uint64_t size)
+{
+	size = (size + 0xffff) & ~0xffffull;
+	for (unsigned i = 0; i < va_free_count; i++) {
+		if (va_free[i].size >= size) {
+			uint64_t address = va_free[i].start;
+			va_free[i].start += size;
+			va_free[i].size -= size;
+			if (va_free[i].size == 0) {
+				memmove(&va_free[i], &va_free[i + 1], (--va_free_count - i) * sizeof(va_free[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+void
+redwood_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = (size + 0xffff) & ~0xffffull;
+	for (at = 0; at < va_free_count && va_free[at].start < address; at++) {
+	}
+	if (at > 0 && va_free[at - 1].start + va_free[at - 1].size == address) {
+		va_free[at - 1].size += size;
+		if (at < va_free_count && address + size == va_free[at].start) {
+			va_free[at - 1].size += va_free[at].size;
+			memmove(&va_free[at], &va_free[at + 1], (--va_free_count - at) * sizeof(va_free[0]));
+		}
+	} else if (at < va_free_count && address + size == va_free[at].start) {
+		va_free[at].start = address;
+		va_free[at].size += size;
+	} else if (va_free_count < sizeof(va_free) / sizeof(va_free[0])) {
+		memmove(&va_free[at + 1], &va_free[at], (va_free_count++ - at) * sizeof(va_free[0]));
+		va_free[at].start = address;
+		va_free[at].size = size;
+	}
+}
+
+/* ---------------------------------------------------------------- HFI */
+
+static void
+hfi_init(void)
+{
+	struct hfi_queue_table *t = (struct hfi_queue_table *)(hfi_mem.va + (hfi_mem.iova & 0xfff));
+	static const uint32_t ids[HFI_QUEUES] = { 0, 4, 5 };
+	static const uint32_t prio[HFI_QUEUES] = { 10, 10, 40 };
+
+	bzero(t, sizeof(*t));
+	t->qtbl_hdr.version = 0;
+	t->qtbl_hdr.size = sizeof(*t) >> 2;
+	t->qtbl_hdr.qhdr0_offset = sizeof(struct hfi_queue_table_header) >> 2;
+	t->qtbl_hdr.qhdr_size = sizeof(struct hfi_queue_header) >> 2;
+	t->qtbl_hdr.num_q = HFI_QUEUES;
+	t->qtbl_hdr.num_active_q = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		struct hfi_queue_header *q = &t->qhdr[i];
+		q->status = 1;
+		q->start_addr = (uint32_t)(hfi_mem.iova + HFI_QUEUE_OFFSET(i));
+		q->type = ids[i] | (prio[i] << 8);
+		q->queue_size = HFI_QUEUE_WORDS;
+		q->msg_size = 0;
+		q->drop_cnt = 0;
+		q->rx_wm = 1;
+		q->tx_wm = 1;
+		q->rx_req = 1;
+		q->tx_req = 0;
+		q->read_index = 0;
+		q->write_index = 0;
+	}
+	dcache_sync(hfi_mem.va, hfi_mem.size);
+}
+
+static bool
+hfi_receive(unsigned which, uint32_t id, uint32_t number, uint32_t *verdict)
+{
+	volatile struct hfi_queue_header *q = &hfi->qhdr[which];
+	volatile uint32_t *data = (volatile uint32_t *)(hfi_mem.va + (hfi_mem.iova & 0xfff) + HFI_QUEUE_OFFSET(which));
+	bool answered = false;
+
+	while (q->read_index != q->write_index) {
+		uint32_t at = q->read_index % HFI_QUEUE_WORDS;
+		uint32_t first = data[at];
+		uint32_t words = (first >> 8) & 0xff;
+		uint32_t message[16] = { 0 };
+
+		if (words == 0 || words > 16) {
+			break;
+		}
+		for (uint32_t i = 0; i < words; i++) {
+			message[i] = data[at];
+			at = (at + 1) % HFI_QUEUE_WORDS;
+		}
+		q->read_index = at;
+		if ((first & 0xff) == HFI_MSG_ACK) {
+			struct hfi_msg_rsp *rsp = (struct hfi_msg_rsp *)message;
+			if (rsp->ret_hdr.id == id && rsp->ret_hdr.seqnum == number) {
+				*verdict = rsp->error;
+				for (unsigned i = 0; i < 4; i++) {
+					hfi_last_payload[i] = rsp->payload[i];
+				}
+				answered = true;
+			} else if (hfi_debug_logs < 4) {
+				hfi_debug_logs++;
+				IOLog("POLARIS GPU: HFI ACK id %u seq %u for %u/%u error %u\n",
+				    rsp->ret_hdr.id, rsp->ret_hdr.seqnum, id, number, rsp->error);
+			}
+		} else if ((first & 0xff) == HFI_MSG_ERR) {
+			IOLog("POLARIS GPU: GMU ERROR id %u words %u: %08x %08x %08x %08x\n",
+			    first & 0xff, words, message[1], message[2], message[3], message[4]);
+		} else if (hfi_debug_logs < 8) {
+			hfi_debug_logs++;
+			IOLog("POLARIS GPU: GMU msg queue %u id %u words %u: %08x %08x %08x %08x\n",
+			    which, first & 0xff, words, message[0], message[1], message[2], message[3]);
+		}
+	}
+	return answered;
+}
+
+static bool
+hfi_send(uint32_t id, void *message, uint32_t words, uint32_t *verdict)
+{
+	struct hfi_msg_hdr *h = (struct hfi_msg_hdr *)message;
+	volatile struct hfi_queue_header *q = &hfi->qhdr[0];
+	volatile uint32_t *data = (volatile uint32_t *)(hfi_mem.va + (hfi_mem.iova & 0xfff) + HFI_QUEUE_OFFSET(0));
+	uint32_t number = ++hfi_seq & 0xfff;
+	uint32_t at = q->write_index % HFI_QUEUE_WORDS;
+	bool answered = false;
+
+	h->id = id;
+	h->size = words;
+	h->type = 0;
+	h->seqnum = number;
+
+	for (uint32_t i = 0; i < words; i++) {
+		data[at] = ((uint32_t *)message)[i];
+		at = (at + 1) % HFI_QUEUE_WORDS;
+	}
+	q->write_index = at;
+	dcache_sync(hfi_mem.va, hfi_mem.size);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(gmu, GMU_HOST2GMU_INTR_SET, 1);
+
+	for (uint32_t i = 0; i < 5000 && !answered; i++) {
+		uint32_t info = rd(gmu, GMU_GMU2HOST_INTR_INFO);
+		if (info & 1) {
+			wr(gmu, GMU_GMU2HOST_INTR_CLR, 1);
+			dcache_sync(hfi_mem.va, hfi_mem.size);
+			answered = hfi_receive(1, id, number, verdict);
+		}
+		if ((rd(gmu, GMU_CM3_FW_INIT_RESULT) & 0xffff0000) == 0xdead0000) {
+			break;
+		}
+		IODelay(100);
+	}
+	if (!answered) {
+		IOLog("POLARIS GPU: HFI id %u seq %u no answer; fw %08x intr %08x hfi %08x\n",
+		    id, number, rd(gmu, GMU_CM3_FW_INIT_RESULT), rd(gmu, GMU_GMU2HOST_INTR_INFO),
+		    rd(gmu, GMU_HFI_CTRL_STATUS));
+		smmu_fault("hfi");
+	}
+	return answered;
+}
+
+/* ---------------------------------------------------------------- RSC/PDC */
+
+static void
+rsc_pdc_program(void)
+{
+	/* RSC sequencer for the GMU's RPMh channel (MiCode _load_gmu_rpmh_ucode). */
+	wr(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0, rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0) | (1u << 24));
+	wr(gmu, GMU_RSCC_PDC_SLAVE_ID_DRV0, 1);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_DATA, 0);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_ADDR, 0);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_DATA + 8, 0);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_ADDR + 8, 0);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_DATA + 16, 0x80000000);
+	wr(gmu, GMU_RSCC_HIDDEN_TCS_CMD0_ADDR + 16, 0);
+	wr(gmu, GMU_RSCC_OVERRIDE_START_ADDR, 0);
+	wr(gmu, GMU_RSCC_PDC_SEQ_START_ADDR, 0x4520);
+	wr(gmu, GMU_RSCC_PDC_MATCH_VALUE_LO, 0x4510);
+	wr(gmu, GMU_RSCC_PDC_MATCH_VALUE_HI, 0x4514);
+	/* The bootloader leaves RSCC_SEQ_MEM zero when the kernel is entered
+	 * through fastboot boot; program the A630 wake/sleep sequence here.
+	 * Leave the PDC TCS program to the bootloader/PDC driver, as the
+	 * vendor _load_gmu_rpmh_ucode does. */
+	wr(gmu, GMU_RSCC_SEQ_MEM_0_DRV0 + 0, 0xa7a506a0);
+	wr(gmu, GMU_RSCC_SEQ_MEM_0_DRV0 + 4, 0xa1e6a6e7);
+	wr(gmu, GMU_RSCC_SEQ_MEM_0_DRV0 + 8, 0xa2e081e1);
+	wr(gmu, GMU_RSCC_SEQ_MEM_0_DRV0 + 12, 0xe9a982e2);
+	wr(gmu, GMU_RSCC_SEQ_MEM_0_DRV0 + 16, 0x0020e8a8);
+	/* The bootloader does not program the PDC TCS sequence on the
+	 * fastboot-boot path; program it here. */
+	wr(pdc, 4 * PDC_GPU_SEQ_MEM_0 + 0, 0xfebea1e1);
+	wr(pdc, 4 * PDC_GPU_SEQ_MEM_0 + 4, 0xa5a4a3a2);
+	wr(pdc, 4 * PDC_GPU_SEQ_MEM_0 + 8, 0x8382a6e0);
+	wr(pdc, 4 * PDC_GPU_SEQ_MEM_0 + 12, 0xbce3e284);
+	wr(pdc, 4 * PDC_GPU_SEQ_MEM_0 + 16, 0x002081fc);
+	wr(pdc, 4 * PDC_GPU_TCS1_CMD_ENABLE_BANK, 7);
+	wr(pdc, 4 * PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK, 0);
+	wr(pdc, 4 * PDC_GPU_TCS1_CONTROL, 0);
+	wr(pdc, 4 * PDC_GPU_TCS1_CMD0_MSGID, 0x10108);
+	wr(pdc, 4 * PDC_GPU_TCS1_CMD0_ADDR, 0x30010);
+	wr(pdc, 4 * PDC_GPU_TCS1_CMD0_DATA, 1);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_MSGID + 4), 0x10108);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_ADDR + 4), 0x30000);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_DATA + 4), 0);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_MSGID + 8), 0x10108);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_ADDR + 8), 0x30080);
+	wr(pdc, 4 * (PDC_GPU_TCS1_CMD0_DATA + 8), 0);
+	wr(pdc, 4 * PDC_GPU_TCS3_CMD_ENABLE_BANK, 7);
+	wr(pdc, 4 * PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK, 0);
+	wr(pdc, 4 * PDC_GPU_TCS3_CONTROL, 0);
+	wr(pdc, 4 * PDC_GPU_TCS3_CMD0_MSGID, 0x10108);
+	wr(pdc, 4 * PDC_GPU_TCS3_CMD0_ADDR, 0x30010);
+	wr(pdc, 4 * PDC_GPU_TCS3_CMD0_DATA, 2);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_MSGID + 4), 0x10108);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_ADDR + 4), 0x30000);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_DATA + 4), 3);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_MSGID + 8), 0x10108);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_ADDR + 8), 0x30080);
+	wr(pdc, 4 * (PDC_GPU_TCS3_CMD0_DATA + 8), 3);
+	wr(pdc, 4 * PDC_GPU_SEQ_START_ADDR, 0);
+	wr(pdc, 4 * PDC_GPU_ENABLE_PDC, 0x80000001);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+rsc_wake(void)
+{
+	uint32_t status = rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0);
+
+	/* The GMU's RPMh channel is a sequencer in the always-on block.  The
+	 * vendor only asks it to wake when it has been handed to the
+	 * always-on sequencer (RSC_STATUS0 bit 16); writing the request when
+	 * it is already awake leaves ACK clear and is not an error.  Do this
+	 * before the CM3 starts: the firmware's first RPMh vote needs the
+	 * channel awake. */
+	IOLog("POLARIS GPU: RSC status %08x (asleep %u) req %08x ack %08x busy %08x\n",
+	    status, !!(status & (1u << 16)), rd(gmu, GMU_RSCC_CONTROL_REQ),
+	    rd(gmu, GMU_RSCC_CONTROL_ACK), rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0));
+	if (!(status & (1u << 16))) {
+		IOLog("POLARIS GPU: RSC already awake; no wake request\n");
+		return;
+	}
+	wr(gmu, GMU_RSCC_CONTROL_REQ, 2);
+	if (!poll(gmu, GMU_RSCC_CONTROL_ACK, 2, 2, 100000)) {
+		IOLog("POLARIS GPU: RSC wake not acknowledged (req %08x ack %08x busy %08x status %08x)\n",
+		    rd(gmu, GMU_RSCC_CONTROL_REQ), rd(gmu, GMU_RSCC_CONTROL_ACK),
+		    rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0), rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0));
+	}
+	if (!poll(gmu, GMU_RSCC_SEQ_BUSY_DRV0, 0xffffffff, 0, 100000)) {
+		IOLog("POLARIS GPU: RSC sequencer stays busy (%08x)\n", rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0));
+	}
+	wr(gmu, GMU_RSCC_CONTROL_REQ, 0);
+	IOLog("POLARIS GPU: RSC status after wake %08x ack %08x busy %08x\n",
+	    rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0), rd(gmu, GMU_RSCC_CONTROL_ACK),
+	    rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0));
+}
+
+/* ---------------------------------------------------------------- GMU */
+
+static bool
+gmu_load_fw(void)
+{
+	void *fw = NULL;
+	size_t fw_size = 0;
+	uint32_t wrong = 0;
+	const uint32_t *w;
+
+	if (polaris_fw_read(FW_DIR "a630_gmu.bin", &fw, &fw_size) || fw_size != 0x8000) {
+		IOLog("POLARIS GPU: a630_gmu.bin missing or not 32768 bytes (%u)\n", (unsigned)fw_size);
+		polaris_fw_free(fw, fw_size);
+		return false;
+	}
+	wr(gmu, GMU_CM3_SYSRESET, 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	w = (const uint32_t *)fw;
+	for (uint32_t i = 0; i < 0x2000; i++) {
+		wr(gmu, GMU_CM3_ITCM_START + 4 * i, w[i]);
+	}
+	for (uint32_t i = 0; i < 4; i++) {
+		if (rd(gmu, GMU_CM3_ITCM_START + 4 * i) != w[i]) {
+			wrong++;
+		}
+	}
+	for (uint32_t i = 0x1ffc; i < 0x2000; i++) {
+		if (rd(gmu, GMU_CM3_ITCM_START + 4 * i) != w[i]) {
+			wrong++;
+		}
+	}
+	IOLog("POLARIS GPU: GMU firmware loaded (%u bytes), %u readback errors, first %08x %08x %08x %08x\n",
+	    (unsigned)fw_size, wrong, w[0], w[1], w[2], w[3]);
+	polaris_fw_free(fw, fw_size);
+	return wrong == 0;
+}
+
+static bool
+gmu_start(void)
+{
+	/* The vendor only writes the FAL/FALNEXT veto on A650 and later;
+	 * mainline does the same.  A630 has no such interface, and writing
+	 * these reserved registers before boot perturbs the OOB path. */
+	wr(gmu, GMU_GENERAL_7, 1);
+	wr(gmu, GMU_CM3_FW_INIT_RESULT, 0);
+	wr(gmu, GMU_CM3_BOOT_CONFIG, 2);                        /* TCM_BOOT */
+	wr(gmu, GMU_HFI_QTBL_ADDR, (uint32_t)hfi_mem.iova);
+	wr(gmu, GMU_HFI_QTBL_INFO, 1);
+	wr(gmu, GMU_AHB_FENCE_RANGE_0, FENCE_RANGE_MASK);
+	wr(gmu, GMU_CM3_CFG, 0x4052);                           /* normal boot value */
+	wr(gmu, GMU_PWR_COL_CP_RESP, 0);
+	wr(gmu, GMU_HFI_SFR_ADDR, (uint32_t)GPU_CHIP_FW);
+	wr(gmu, GMU_PWR_COL_CP_MSG, (uint32_t)dump_mem.iova | (uint32_t)(dump_mem.size / 4096 - 1));
+	wr(gmu, GMU_SYS_BUS_CONFIG, 1);
+	wr(gmu, GMU_ICACHE_CONFIG, 1);
+	wr(gmu, GMU_DCACHE_CONFIG, 1);
+	wr(gmu, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	wr(gmu, GMU_PWR_COL_INTER_FRAME_HYST, 0x000a1680);
+	wr(gmu, GMU_PWR_COL_SPTPRAC_HYST, 0x000a1680);
+	wr(gmu, GMU_RPMH_CTRL, 0xf11);
+	wr(gmu, GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	rmw(gmu, GMU_GMU2HOST_INTR_MASK, 1, 0);
+
+	wr(gmu, GMU_CM3_SYSRESET, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!poll(gmu, GMU_CM3_FW_INIT_RESULT, 0xffffffff, GMU_STARTED, 200000)) {
+		IOLog("POLARIS GPU: GMU did not boot: fw_init %08x sysreset %08x hfi %08x intr %08x\n",
+		    rd(gmu, GMU_CM3_FW_INIT_RESULT), rd(gmu, GMU_CM3_SYSRESET),
+		    rd(gmu, GMU_HFI_CTRL_STATUS), rd(gmu, GMU_GMU2HOST_INTR_INFO));
+		return false;
+	}
+	gmu_up = true;
+	IOLog("POLARIS GPU: GMU firmware runs: fw_init %08x, DTCM %08x %08x %08x %08x\n",
+	    rd(gmu, GMU_CM3_FW_INIT_RESULT), rd(gmu, GMU_CM3_DTCM_START + 0x3fe0),
+	    rd(gmu, GMU_CM3_DTCM_START + 0x3fe4), rd(gmu, GMU_CM3_DTCM_START + 0x3fe8),
+	    rd(gmu, GMU_CM3_DTCM_START + 0x3fec));
+	return true;
+}
+
+/* a6xx_gfx_rail_on + a6xx_sptprac_enable: both run before HFI start. */
+static bool
+gmu_gfx_rail_on(void)
+{
+	bool ok, ok_low;
+	/* Mainline's legacy A6xx BOOT_SLUMBER handshake votes the highest
+	 * available ARC level.  The DTB initial-pwrlevel is 280 MHz, whose
+	 * OPP voltage is VLVL 320 (gx=6); try both, because the GMU firmware
+	 * may validate the vote index against the OPP table it was built
+	 * with. */
+	uint32_t vote = arc_vote(385, &gfx_levels, &mx_levels, &ok); /* gx=8, VLVL 416 */
+	uint32_t vote_low = arc_vote(257, &gfx_levels, &mx_levels, &ok_low); /* gx=6, VLVL 320 */
+	uint32_t gx = vote & 0xff, mx = (vote >> 8) & 0xff;
+	uint32_t gx_low = vote_low & 0xff;
+
+	if (!ok) {
+		gx = mx = 0;
+	}
+	if (!ok_low) {
+		gx_low = 0;
+	}
+	IOLog("POLARIS GPU: rail votes high raw=%08x gx=%u mx=%u ok=%d low raw=%08x gx=%u ok=%d\n",
+	    vote, gx, mx, ok, vote_low, gx_low, ok_low);
+	IOLog("POLARIS GPU: rail pre rpmh_ctrl=%08x hyst=%08x state=%08x req=%08x ack=%08x busy=%08x\n",
+	    rd(gmu, GMU_RPMH_CTRL), rd(gmu, GMU_RPMH_HYST_CTRL),
+	    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_RSCC_CONTROL_REQ),
+	    rd(gmu, GMU_RSCC_CONTROL_ACK), rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0));
+	for (int attempt = 0; attempt < 2; attempt++) {
+		/* Try the shifted host request bit first with the 280 MHz OPP's
+		 * VLVL; the vendor BIT(22) and highest vote are the retry.
+		 * Only INFO bit 30 is a real BOOT_SLUMBER ACK. */
+		uint32_t set_bit = attempt == 0 ? 21 : 22;
+		uint32_t attempt_gx = attempt == 0 ? gx_low : gx;
+		uint32_t ack_mask = 1u << 30;
+
+		if (attempt) {
+			/* Clear only the BOOT_SLUMBER acknowledge.  Writing the
+			 * DCVS set bit here would make the GMU run a DCVS OOB
+			 * and answer with INFO bit 23 instead. */
+			wr(gmu, GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+			wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << 30);
+			IODelay(1000);
+		}
+		wr(gmu, GMU_BOOT_SLUMBER_OPTION, 0);
+		wr(gmu, GMU_GX_VOTE_IDX, attempt_gx);
+		wr(gmu, GMU_MX_VOTE_IDX, mx);
+		IOLog("POLARIS GPU: rail attempt %d set=%u gx=%u pre-set raw=%08x intr=%08x state=%08x status0=%08x tcs0=%08x\n",
+		    attempt, set_bit, attempt_gx, rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO), rd(gmu, GMU_GMU2HOST_INTR_INFO),
+		    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0),
+		    rd(gmu, GMU_RSCC_TCS0_DRV0_STATUS));
+		wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << set_bit);
+		IOLog("POLARIS GPU: rail attempt %d set=%u gx=%u post intr=%08x raw=%08x state=%08x gx=%08x mx=%08x\n",
+		    attempt, set_bit, attempt_gx, rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO),
+		    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_GX_VOTE_IDX), rd(gmu, GMU_MX_VOTE_IDX));
+		if (oob_poll(ack_mask)) {
+			IOLog("POLARIS GPU: rail attempt %d accepted intr=%08x raw=%08x\n",
+			    attempt, rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO));
+			wr(gmu, GMU_GMU2HOST_INTR_CLR, ack_mask);
+			break;
+		}
+		if (attempt == 0) {
+			IOLog("POLARIS GPU: BOOT_SLUMBER gx=%u timed out (intr=%08x raw=%08x); retrying gx=%u\n",
+			    attempt_gx, rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO), gx_low);
+			continue;
+		}
+		IOLog("POLARIS GPU: no BOOT_SLUMBER_ACK intr=%08x raw=%08x state=%08x status0=%08x tcs=%08x/%08x/%08x/%08x ack=%08x busy=%08x ao_int=%08x ao_busy=%08x sptprac=%08x gdscr=%08x\n",
+		    rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO),
+		    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_GPU_RSCC_RSC_STATUS0_DRV0),
+		    rd(gmu, GMU_RSCC_TCS0_DRV0_STATUS), rd(gmu, GMU_RSCC_TCS1_DRV0_STATUS),
+		    rd(gmu, GMU_RSCC_TCS2_DRV0_STATUS), rd(gmu, GMU_RSCC_TCS3_DRV0_STATUS),
+		    rd(gmu, GMU_RSCC_CONTROL_ACK), rd(gmu, GMU_RSCC_SEQ_BUSY_DRV0),
+		    rd(gmu, GMU_AO_HOST_INTERRUPT_STATUS), rd(gmu, GMU_AO_GPU_CX_BUSY_STATUS),
+		    rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS), rd(gpucc, GPUCC_GX_GDSCR));
+		wr(gmu, GMU_GMU2HOST_INTR_CLR, 1u << 30);
+		wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << 30);
+		return false;
+	}
+
+	wr(gmu, GMU_GX_SPTPRAC_POWER_CONTROL, 0x00778000);
+	/* Mainline's legacy check: bits 3 and 5 on, bit 4 (SP clock off) clear. */
+	if (!poll(gmu, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38, 0x28, 100000)) {
+		IOLog("POLARIS GPU: SPTPRAC not on (%08x)\n", rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS));
+		return false;
+	}
+	IOLog("POLARIS GPU: GX rail on (gx %u mx %u), SPTPRAC %08x\n",
+	    gx, mx, rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS));
+	return true;
+}
+
+/* a6xx_gmu_oob_set(GPU_SET) + legacy DCVS, after the HFI messages. */
+static bool
+gmu_gpu_set(void)
+{
+	bool ok;
+	uint32_t vote = arc_vote(65, &gfx_levels, &mx_levels, &ok); /* LOW_SVS */
+	uint32_t gx = vote & 0xff, mx = (vote >> 8) & 0xff;
+
+	if (!ok) {
+		gx = mx = 0;
+	}
+	wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << 16);
+	if (!oob_poll(1u << 24)) {
+		IOLog("POLARIS GPU: GMU did not grant GX (gx %u mx %u): intr %08x raw %08x fw %08x sp %08x rpmh %08x fence %08x\n",
+		    gx, mx, rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO),
+		    rd(gmu, GMU_CM3_FW_INIT_RESULT), rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS),
+		    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_AHB_FENCE_STATUS));
+		return false;
+	}
+	wr(gmu, GMU_GMU2HOST_INTR_CLR, 1u << 24);
+	IOLog("POLARIS GPU: GMU granted GX (gx %u mx %u): sp %08x rpmh %08x fence %08x\n",
+	    gx, mx, rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS), rd(gmu, GMU_RPMH_POWER_STATE),
+	    rd(gmu, GMU_AHB_FENCE_STATUS));
+
+	wr(gmu, GMU_DCVS_ACK_OPTION, 0);
+	wr(gmu, GMU_DCVS_PERF_SETTING, ((3 & 0xf) << 28) | gx);
+	wr(gmu, GMU_DCVS_BW_SETTING, 0xff);
+	wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << 23);
+	if (!oob_poll(1u << 31)) {
+		IOLog("POLARIS GPU: DCVS no ACK (intr %08x raw %08x)\n",
+		    rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_HOST2GMU_INTR_RAW_INFO));
+	} else {
+		wr(gmu, GMU_GMU2HOST_INTR_CLR, 1u << 31);
+	}
+	IOLog("POLARIS GPU: DCVS return %d\n", (int32_t)rd(gmu, GMU_DCVS_RETURN));
+
+	core_up = true;
+	IOLog("POLARIS GPU: SPTPRAC on, GX status %08x\n", rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS));
+	return true;
+}
+
+static bool
+gmu_hfi_start(void)
+{
+	rmw(gmu, GMU_GMU2HOST_INTR_MASK, 1, 0);
+	wr(gmu, GMU_HFI_CTRL_INIT, 1);
+	if (!poll(gmu, GMU_HFI_CTRL_STATUS, 1, 1, 500000)) {
+		IOLog("POLARIS GPU: HFI queues did not start: ctrl %08x fw %08x intr %08x\n",
+		    rd(gmu, GMU_HFI_CTRL_STATUS), rd(gmu, GMU_CM3_FW_INIT_RESULT),
+		    rd(gmu, GMU_GMU2HOST_INTR_INFO));
+		smmu_fault("hfi-start");
+		return false;
+	}
+	IOLog("POLARIS GPU: HFI queues up: status %08x version %08x\n",
+	    rd(gmu, GMU_HFI_CTRL_STATUS), rd(gmu, GMU_HFI_VERSION_INFO));
+	return true;
+}
+
+static bool
+gmu_hfi_messages(void)
+{
+	static const uint32_t freqs[8] = { 0, 257000, 342000, 414000, 520000, 596000, 675000, 710000 };
+	static const uint16_t levels[8] = { 1, 65, 129, 193, 257, 321, 385, 417 };
+	struct hfi_gmu_init_cmd init = {};
+	struct hfi_fw_version_cmd ver = {};
+	struct hfi_dcvstable_cmd perf = {};
+	struct hfi_bwtable_cmd bw = {};
+	struct hfi_test_cmd test = {};
+	uint32_t verdict = 0;
+
+	init.seg_id = 0;
+	init.dbg_buffer_addr = (uint32_t)dump_mem.iova;
+	init.dbg_buffer_size = (uint32_t)dump_mem.size;
+	init.boot_state = 1;                                    /* COLD_BOOT */
+	if (!hfi_send(HFI_MSG_INIT, &init, sizeof(init) / 4, &verdict) || verdict != 0) {
+		IOLog("POLARIS GPU: HFI INIT failed (verdict %u)\n", verdict);
+		return false;
+	}
+	IOLog("POLARIS GPU: HFI INIT accepted\n");
+
+	ver.supported_ver = 0x10010000;                         /* A630v2 GMU 1.1 */
+	if (hfi_send(HFI_MSG_FW_VER, &ver, sizeof(ver) / 4, &verdict) && verdict == 0) {
+		IOLog("POLARIS GPU: GMU firmware version %08x\n", hfi_last_payload[0]);
+	} else {
+		IOLog("POLARIS GPU: HFI FW_VER failed (verdict %u)\n", verdict);
+	}
+
+	perf.gpu_level_num = 8;
+	perf.gmu_level_num = 3;
+	for (unsigned i = 0; i < 8; i++) {
+		bool ok;
+		perf.gx_votes[i].vote.raw = arc_vote(levels[i], &gfx_levels, &mx_levels, &ok);
+		if (!ok) {
+			perf.gx_votes[i].vote.raw = 0;
+		}
+		perf.gx_votes[i].freq = freqs[i];
+	}
+	perf.cx_votes[0].freq = 200000;
+	perf.cx_votes[1].freq = 500000;
+	perf.cx_votes[2].freq = 710000;
+	if (hfi_send(HFI_MSG_PERF_TBL, &perf, sizeof(perf) / 4, &verdict) && verdict == 0) {
+		IOLog("POLARIS GPU: HFI perf table accepted\n");
+	} else {
+		IOLog("POLARIS GPU: HFI perf table failed (verdict %u)\n", verdict);
+	}
+
+	bw.bw_level_num = 1;
+	bw.cnoc_cmds_num = 3;
+	bw.ddr_cmds_num = 3;
+	bw.cnoc_wait_bitmask = 0x05;
+	bw.ddr_wait_bitmask = 0x07;
+	bw.cnoc_cmd_addrs[0] = 0x50034;
+	bw.cnoc_cmd_addrs[1] = 0x5007c;
+	bw.cnoc_cmd_addrs[2] = 0x5004c;
+	bw.cnoc_cmd_data[0][0] = 0x40000000;
+	bw.cnoc_cmd_data[0][1] = 0;
+	bw.cnoc_cmd_data[0][2] = 0x40000000;
+	bw.ddr_cmd_addrs[0] = 0x50000;
+	bw.ddr_cmd_addrs[1] = 0x5005c;
+	bw.ddr_cmd_addrs[2] = 0x5000c;
+	bw.ddr_cmd_data[0][0] = 0x40000000;
+	bw.ddr_cmd_data[0][1] = 0x40000000;
+	bw.ddr_cmd_data[0][2] = 0x40000000;
+	if (hfi_send(HFI_MSG_BW_VOTE_TBL, &bw, sizeof(bw) / 4, &verdict) && verdict == 0) {
+		IOLog("POLARIS GPU: HFI bandwidth table accepted\n");
+	} else {
+		IOLog("POLARIS GPU: HFI bandwidth table failed (verdict %u)\n", verdict);
+	}
+
+	if (hfi_send(HFI_MSG_TEST, &test, sizeof(test) / 4, &verdict) && verdict == 0) {
+		IOLog("POLARIS GPU: HFI TEST accepted (register DCVS mode)\n");
+	} else {
+		IOLog("POLARIS GPU: HFI TEST failed (verdict %u)\n", verdict);
+	}
+	return true;
+}
