+static void
+dump_gmu_log(const char *tag)
+{
+	uint32_t next, entries;
+	volatile uint32_t *log;
+
+	if (!gpu_dump || dump_mem.va == 0) {
+		return;
+	}
+	next = rd(gmu, GMU_PWR_COL_CP_RESP) & 0xffff;
+	entries = (uint32_t)(dump_mem.size / 16);
+	log = (volatile uint32_t *)dump_mem.va;
+	IOLog("POLARIS GPU: GMU[%s] log next=%u entries=%u\n", tag, next, entries);
+	for (uint32_t i = next > 40 ? next - 40 : 0; i < next && i + 4 <= entries; i += 4) {
+		IOLog("POLARIS GPU: GMU[%s] log %08x %08x %08x %08x | %08x %08x %08x %08x | %08x %08x %08x %08x | %08x %08x %08x %08x\n",
+		    tag, log[4 * i], log[4 * i + 1], log[4 * i + 2], log[4 * i + 3],
+		    log[4 * i + 4], log[4 * i + 5], log[4 * i + 6], log[4 * i + 7],
+		    log[4 * i + 8], log[4 * i + 9], log[4 * i + 10], log[4 * i + 11],
+		    log[4 * i + 12], log[4 * i + 13], log[4 * i + 14], log[4 * i + 15]);
+	}
+}
+
+static void
+dump_gmu_nmi(const char *tag)
+{
+	volatile uint32_t *dtcm = (volatile uint32_t *)((uint8_t *)gmu + GMU_CM3_DTCM_START);
+
+	if (!gpu_dump) {
+		return;
+	}
+	wr(gmu, GMU_NMI_CONTROL_STATUS, 0);
+	wr(gmu, GMU_CM3_CFG, 1u << 9);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	IODelay(100);
+	for (unsigned i = 0; i < 0x100; i += 4) {
+		IOLog("POLARIS GPU: GMU[%s] dtcm %03x: %08x %08x %08x %08x\n",
+		    tag, i, dtcm[i], dtcm[i + 1], dtcm[i + 2], dtcm[i + 3]);
+	}
+}
+
+static void
+dump_gpu(const char *tag)
+{
+	if (!gpu_dump) {
+		return;
+	}
+	IOLog("POLARIS GPU: GPU[%s] rbbm_id=%08x rbbm_status=%08x cp_rb_base=%08x%08x cp_rb_cntl=%08x cp_rptr=%08x cp_wptr=%08x cp_me=%08x cp_sqe=%08x%08x cp_fault=%08x cp_int=%08x\n",
+	    tag, gpu_rd(0x0), gpu_rd(0x210), gpu_rd(0x801), gpu_rd(0x800),
+	    gpu_rd(0x802), gpu_rd(0x806), gpu_rd(0x807), gpu_rd(0x808),
+	    gpu_rd(0x831), gpu_rd(0x830), gpu_rd(0x821), gpu_rd(0x92a));
+}
+
+static void
+dump_hfi(const char *tag)
+{
+	if (!gpu_dump) {
+		return;
+	}
+	IOLog("POLARIS GPU: HFI[%s] va=%p pa=%08llx iova=%08llx size=%llx hfi=%p\n",
+	    tag, hfi_mem.va, hfi_mem.pa, hfi_mem.iova, hfi_mem.size, (void *)hfi);
+	if (hfi != NULL) {
+		for (unsigned i = 0; i < 2; i++) {
+			IOLog("POLARIS GPU: HFI[%s] q%u read=%u write=%u size=%u\n",
+			    tag, i, hfi->qhdr[i].read_index, hfi->qhdr[i].write_index,
+			    hfi->qhdr[i].queue_size);
+		}
+	}
+}
+
+static bool
+gmu_bringup(void)
+{
+	if (!kbuf_alloc(&hfi_mem, 0x4000)) {
+		IOLog("POLARIS GPU: GMU HFI allocation failed\n");
+		return false;
+	}
+	/* The A630 bootloader leaves the GMU's HFI table at this fixed IOVA;
+	 * the GMU firmware ignores our GMU_HFI_QTBL_ADDR write and reads it
+	 * there.  Map our table at that address. */
+	hfi_mem.iova = 0x6AB6FBC4ull;
+	if (!kbuf_map(&hfi_mem, false) ||
+	    !kbuf_alloc(&dump_mem, 0x4000) || !kbuf_map(&dump_mem, false)) {
+		IOLog("POLARIS GPU: GMU shared memory allocation failed\n");
+		return false;
+	}
+	dump_hfi("alloc");
+	hfi = (volatile struct hfi_queue_table *)(hfi_mem.va + (hfi_mem.iova & 0xfff));
+	hfi_init();
+	dump_hfi("init");
+	if (!power_up()) {
+		return false;
+	}
+	dump_gpucc("power");
+	dump_gmu("power");
+	dump_gpu("power");
+	if (!smmu_setup()) {
+		return false;
+	}
+	dump_gmu("smmu");
+	arc_init();
+	dump_arc("arc");
+	rsc_pdc_program();
+	dump_rsc("pdc");
+	if (!gmu_load_fw()) {
+		return false;
+	}
+	dump_gmu("fw");
+	dump_gpu("fw");
+	/* Wake the GMU's RPMh channel before the CM3 starts: the firmware's
+	 * first vote happens during boot.  The vendor does this on warm boot
+	 * and HackiOS does it before releasing CM3 reset. */
+	rsc_wake();
+	dump_gmu("rsc");
+	dump_rsc("rsc");
+	if (!gmu_start()) {
+		return false;
+	}
+	dump_gmu("start");
+	dump_hfi("start");
+	if (!gmu_gfx_rail_on()) {
+		dump_gmu("rail-fail");
+		dump_rsc("rail-fail");
+		dump_gmu_log("rail-fail");
+		dump_gmu_nmi("rail-fail");
+		return false;
+	}
+	dump_gmu("rail");
+	if (!gmu_hfi_start()) {
+		dump_gmu("hfi-fail");
+		dump_hfi("hfi-fail");
+		return false;
+	}
+	dump_gmu("hfi");
+	dump_hfi("hfi");
+	if (!gmu_hfi_messages()) {
+		IOLog("POLARIS GPU: HFI messages failed; not requesting GX\n");
+		return false;
+	}
+	dump_gmu("msgs");
+	if (!gmu_gpu_set()) {
+		dump_gmu("core-fail");
+		IOLog("POLARIS GPU: core power incomplete; HFI is already up\n");
+	}
+	dump_gmu("done");
+	IOLog("POLARIS GPU: STAGE 1: gmu %s core %s; fw %08x hfi %08x sp %08x rpmh %08x fence %08x aon %08x%08x\n",
+	    gmu_up ? "up" : "?", core_up ? "on" : "off", rd(gmu, GMU_CM3_FW_INIT_RESULT),
+	    rd(gmu, GMU_HFI_CTRL_STATUS), rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS),
+	    rd(gmu, GMU_RPMH_POWER_STATE), rd(gmu, GMU_AHB_FENCE_STATUS),
+	    rd(gmu, GMU_ALWAYS_ON_COUNTER_H), rd(gmu, GMU_ALWAYS_ON_COUNTER_L));
+	return true;
+}
+
+/* ---------------------------------------------------------------- TrustZone: zap shader (stage 2) */
+
+#define SCM_FN(svc, cmd)    (0xc2000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+#define SCM_SVC_PIL         0x02
+#define PIL_INIT_IMAGE      0x01
+#define PIL_MEM_SETUP       0x02
+#define PIL_AUTH_RESET      0x05
+#define PIL_SHUTDOWN        0x06
+#define SCM_ARG_RW          2
+
+static uint64_t
+smc(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+	return x0;
+}
+
+static uint64_t
+scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t args[8] = { fn, arginfo, a, b, c, 0, 0, 0 };
+	smc(args);
+	for (int n = 0; args[0] == 1 && n < 100000; n++) {
+		uint64_t session = args[6];
+		uint64_t again[8] = { 1, arginfo, a, b, c, 0, session, 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	if (res1 != NULL) {
+		*res1 = args[1];
+	}
+	return args[0];
+}
+
+static bool
+zap_load(void)
+{
+	void *mdt = NULL, *seg = NULL;
+	size_t mdt_size = 0, seg_size = 0;
+	struct kbuf meta = {};
+	bool ok = false;
+
+	if (polaris_fw_read(FW_DIR "a630_zap.mdt", &mdt, &mdt_size) ||
+	    polaris_fw_read(FW_DIR "a630_zap.b02", &seg, &seg_size) || mdt_size < 52) {
+		IOLog("POLARIS GPU: zap files missing in " FW_DIR "\n");
+		goto out;
+	}
+	{
+		const uint8_t *m = (const uint8_t *)mdt;
+		uint32_t phoff = *(const uint32_t *)(m + 28), phnum = *(const uint16_t *)(m + 44);
+		uint32_t min_a = 0xffffffff, max_a = 0, seg_paddr = 0;
+		uint64_t st, res = 0;
+
+		for (uint32_t i = 0; i < phnum && phoff + 32 * (i + 1) <= mdt_size; i++) {
+			const uint8_t *ph = m + phoff + 32 * i;
+			uint32_t paddr = *(const uint32_t *)(ph + 12), memsz = *(const uint32_t *)(ph + 20);
+			uint32_t flags = *(const uint32_t *)(ph + 24);
+			if (*(const uint32_t *)ph == 1 && memsz != 0 && ((flags >> 24) & 7) != 2) {
+				min_a = paddr < min_a ? paddr : min_a;
+				uint32_t end = (paddr + memsz + 0xfff) & ~0xfffu;
+				max_a = end > max_a ? end : max_a;
+				seg_paddr = paddr;
+			}
+		}
+		if (max_a <= min_a || max_a - min_a > ZAP_REGION_SIZE) {
+			IOLog("POLARIS GPU: zap layout unexpected\n");
+			goto out;
+		}
+		if (!kbuf_alloc(&meta, mdt_size)) {
+			goto out;
+		}
+		memcpy(meta.va, mdt, mdt_size);
+		dcache_sync(meta.va, meta.size);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, GPU_PAS_ID, 0, 0, &res);
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE), 2 | (SCM_ARG_RW << 6), GPU_PAS_ID, meta.pa, 0, &res);
+		if (st != 0 || res != 0) {
+			IOLog("POLARIS GPU: zap init_image: %llx/%llx\n", st, res);
+			goto out;
+		}
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, GPU_PAS_ID, ZAP_REGION, max_a - min_a, &res);
+		if (st != 0 || res != 0) {
+			IOLog("POLARIS GPU: zap mem_setup: %llx/%llx\n", st, res);
+			goto out;
+		}
+		volatile uint8_t *dst = (volatile uint8_t *)ml_io_map(ZAP_REGION, ZAP_REGION_SIZE);
+		if (dst == NULL) {
+			goto out;
+		}
+		for (uint32_t i = 0; i < ZAP_REGION_SIZE; i += 4) {
+			*(volatile uint32_t *)(dst + i) = 0;
+		}
+		uint32_t at = seg_paddr - min_a, n = (uint32_t)(seg_size < ZAP_REGION_SIZE - at ? seg_size : ZAP_REGION_SIZE - at);
+		for (uint32_t i = 0; i < n; i++) {
+			dst[at + i] = ((const uint8_t *)seg)[i];
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, GPU_PAS_ID, 0, 0, &res);
+		IOLog("POLARIS GPU: zap auth_and_reset: %llx/%llx\n", st, res);
+		ok = st == 0 && res == 0;
+	}
+out:
+	if (meta.va != NULL) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+		IOFreeContiguous(meta.va, meta.size);
+#pragma clang diagnostic pop
+	}
+	polaris_fw_free(mdt, mdt_size);
+	polaris_fw_free(seg, seg_size);
+	return ok;
+}
+
+/* ---------------------------------------------------------------- CP (stage 2) */
+
+static uint32_t
+par(uint32_t v)
+{
+	v ^= v >> 16; v ^= v >> 8; v ^= v >> 4; v &= 0xf;
+	return (0x6996 >> v) & 1;
+}
+
+static void
+emit(uint32_t v)
+{
+	*(volatile uint32_t *)(ring.va + 4 * wptr) = v;
+	wptr = (wptr + 1) % RB_DWORDS;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t words)
+{
+	return (7u << 28) | words | (par(words) << 15) | (op << 16) | (par(op) << 23);
+}
+
+static void
+kick(void)
+{
+	dcache_sync(ring.va, ring.size);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gpu_wr(0x807, wptr);
+}
+
+static uint32_t
+ring_free(void)
+{
+	uint32_t rptr = gpu_rd(0x806);
+	return (rptr + RB_DWORDS - wptr - 1) % RB_DWORDS;
+}
+
+static bool
+ring_idle(uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 100; i++) {
+		if (gpu_rd(0x806) == wptr % RB_DWORDS) {
+			return true;
+		}
+		IODelay(10);
+	}
+	IOLog("POLARIS GPU: ring stuck: rptr %u wptr %u RBBM_STATUS %08x CP_HW_FAULT %08x\n", gpu_rd(0x806),
+	    wptr % RB_DWORDS, gpu_rd(0x210), gpu_rd(0x821));
+	smmu_fault("ring");
+	return false;
+}
+
+static void
+hw_init_regs(void)
+{
+	/* Placeholder A630 register init; stage 2 replaces this with the
+	 * a6xx hw_init sequence before any command is submitted. */
+	gpu_wr(0x16, 0);
+	gpu_wr(0x1f, (1u << 30) | 0x3ffff);
+}
+
+static bool
+cp_start(void)
+{
+	void *fw = NULL;
+	size_t fw_size = 0;
+
+	if (polaris_fw_read(FW_DIR "a630_sqe.fw", &fw, &fw_size) || fw_size <= 4) {
+		IOLog("POLARIS GPU: " FW_DIR "a630_sqe.fw missing\n");
+		polaris_fw_free(fw, fw_size);
+		return false;
+	}
+	if ((sqe.va == NULL && (!kbuf_alloc(&sqe, fw_size - 4) || !kbuf_map(&sqe, true))) ||
+	    (ring.va == NULL && (!kbuf_alloc(&ring, RB_BYTES) || !kbuf_map(&ring, true))) ||
+	    (mem.va == NULL && (!kbuf_alloc(&mem, PAGE_SIZE) || !kbuf_map(&mem, true)))) {
+		IOLog("POLARIS GPU: CP buffers failed\n");
+		polaris_fw_free(fw, fw_size);
+		return false;
+	}
+	memcpy(sqe.va, (const uint8_t *)fw + 4, fw_size - 4);
+	dcache_sync(sqe.va, sqe.size);
+	polaris_fw_free(fw, fw_size);
+	smmu_tables_sync();
+	tlb_flush();
+	hw_init_regs();
+	gpu_wr64(0x830, sqe.iova);
+	gpu_wr64(0x800, ring.iova);
+	gpu_wr(0x802, 12 | (2 << 8) | (1u << 27));
+	wptr = 0;
+	gpu_wr(0x807, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gpu_wr(0x808, 1);
+
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f);
+	emit(3);
+	emit(0x20000000);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	kick();
+	if (!ring_idle(100)) {
+		return false;
+	}
+	emit(pkt7(CP_SET_SECURE_MODE, 1));
+	emit(0);
+	kick();
+	if (!ring_idle(100)) {
+		return false;
+	}
+	IOLog("POLARIS GPU: CP up (ME_INIT, SET_SECURE_MODE 0), core %u MHz\n", core_mhz);
+	return true;
+}
+
+/* ---------------------------------------------------------------- start */
+
+static bool
+hw_start(void)
+{
+	gcc = (volatile uint8_t *)ml_io_map(GCC_BASE, GCC_SIZE);
+	gpucc = (volatile uint8_t *)ml_io_map(GPUCC_BASE, GPUCC_SIZE);
+	gpu = (volatile uint8_t *)ml_io_map(GPU_BASE, GPU_SIZE);
+	smmu = (volatile uint8_t *)ml_io_map(SMMU_BASE, SMMU_SIZE);
+	gmu = (volatile uint8_t *)ml_io_map(GMU_BASE, GMU_SIZE);
+	pdc = (volatile uint8_t *)ml_io_map(PDC_BASE, PDC_SIZE);
+	if (gcc == NULL || gpucc == NULL || gpu == NULL || smmu == NULL || gmu == NULL || pdc == NULL) {
+		IOLog("POLARIS GPU: MMIO map failed\n");
+		return false;
+	}
+	IOLog("POLARIS GPU: MMIO GCC=%llx+%x GPUCC=%llx+%x GPU=%llx+%x SMMU=%llx+%x GMU=%llx+%x PDC=%llx+%x\n",
+	    GCC_BASE, GCC_SIZE, GPUCC_BASE, GPUCC_SIZE, GPU_BASE, GPU_SIZE,
+	    SMMU_BASE, SMMU_SIZE, GMU_BASE, GMU_SIZE, PDC_BASE, PDC_SIZE);
+	va_free_count = 0;
+	redwood_gpu_address_free(VA_USER_START, VA_KERNEL - VA_USER_START);
+	if (!smmu_tables_init()) {
+		return false;
+	}
+	if (!gmu_bringup()) {
+		return false;
+	}
+	if (gpu_stage >= 2) {
+		if (!zap_load() || !cp_start()) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- the interface RedwoodGPU.cpp uses */
+
+bool
+redwood_gpu_ready(void)
+{
+	return ready;
+}
+
+bool
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: *value = 630; return true;                   /* GPU_ID */
+	case 0x02: *value = GMEM_SIZE; return true;             /* GMEM_SIZE */
+	case 0x03: *value = GPU_CHIP_ID; return true;           /* CHIP_ID */
+	case 0x04: *value = 710000000ull; return true;          /* MAX_FREQ */
+	case 0x05:                                              /* TIMESTAMP: CP always-on counter */
+		*value = ready ? ((uint64_t)gpu_rd(0x981) << 32 | gpu_rd(0x980)) : 0;
+		return true;
+	case 0x06: *value = GMEM_BASE; return true;             /* GMEM_BASE */
+	case 0x07: *value = 1; return true;                     /* PRIORITIES */
+	case 0x08: case 0x09: case 0x0a: case 0x11:             /* PP_PGTABLE FAULTS SUSPENDS RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x10: *value = 15; return true;                    /* HIGHEST_BANK_BIT (DT) */
+	case 0x12: *value = 7; return true;                     /* UBWC_SWIZZLE */
+	case 0x13: *value = 0; return true;                     /* MACROTILE_MODE */
+	default:
+		return false;
+	}
+}
+
+bool
+redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return mmu_map(address, phys, read_only, true);
+}
+
+void
+redwood_gpu_mapped(void)
+{
+	if (tables_dirty) {
+		tables_dirty = false;
+		smmu_tables_sync();
+		tlb_flush();
+	}
+}
+
+void
+redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t *t = l3_for(address + off, false);
+		if (t != NULL) {
+			t[((address + off) >> 12) & 511] = 0;
+		}
+	}
+	smmu_tables_sync();
+	tlb_flush();
+}
+
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		dcache_sync(start, size);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+bool
+redwood_gpu_done(uint32_t fence)
+{
+	if (mem.va == NULL) {
+		return false;
+	}
+	dcache_sync(mem.va, mem.size);
+	return (int32_t)(*(volatile uint32_t *)mem.va - fence) >= 0;
+}
+
+uint32_t
+redwood_gpu_last(void)
+{
+	return seqno;
+}
+
+void
+redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+uint32_t
+redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t need = 4 * count + 5;
+
+	if (!ready) {
+		return 0;
+	}
+	IOLockLock(hw_lock);
+	for (int spin = 0; ring_free() < need && spin < 20000; spin++) {
+		IODelay(100);
+	}
+	if (ring_free() < need) {
+		IOLockUnlock(hw_lock);
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		emit(pkt7(CP_INDIRECT_BUFFER, 3));
+		emit((uint32_t)addresses[i]);
+		emit((uint32_t)(addresses[i] >> 32));
+		emit(words[i]);
+	}
+	if (++seqno == 0) {
+		seqno = 1;
+	}
+	uint32_t fence = seqno;
+	emit(pkt7(CP_EVENT_WRITE, 4));
+	emit(CACHE_FLUSH_TS);
+	emit((uint32_t)mem.iova);
+	emit((uint32_t)(mem.iova >> 32));
+	emit(fence);
+	kick();
+	IOLockUnlock(hw_lock);
+	return fence;
+}
+
+void
+redwood_gpu_report(const char *why)
+{
+	uint64_t ib1 = gpu_rd(0x928) | ((uint64_t)gpu_rd(0x929) << 32);
+	if (mem.va != NULL) {
+		dcache_sync(mem.va, mem.size);
+	}
+	IOLog("POLARIS GPU: %s: fence %u done %u rptr %u wptr %u RBBM_STATUS %08x CP_HW_FAULT %08x IB1 %llx rem %u\n", why,
+	    seqno, mem.va ? *(volatile uint32_t *)mem.va : 0, gpu_rd(0x806), wptr % RB_DWORDS, gpu_rd(0x210),
+	    gpu_rd(0x821), ib1, gpu_rd(0x92A));
+	smmu_fault(why);
+}
+
+void
+redwood_gpu_stop(void)
+{
+	if (ready) {
+		gpu_wr(0x808, 0);
+	}
+	ready = false;
+}
+
+void
+redwood_tl(const char *format, ...)
+{
+	(void)format;
+}
+
+/* ---------------------------------------------------------------- thread */
+
+static void
+polaris_adreno_thread(__unused void *param, __unused wait_result_t wr_)
+{
+	for (int i = 0; i < 600 && !polaris_root_mounted(); i++) {
+		IOSleep(100);
+	}
+	IOSleep(500);
+	if (!polaris_root_mounted()) {
+		IOLog("POLARIS GPU: no root filesystem: not started\n");
+		return;
+	}
+	IOLockLock(hw_lock);
+	bool ok = hw_start();
+	IOLockUnlock(hw_lock);
+	if (!ok) {
+		IOLog("POLARIS GPU: BRING-UP FAILED; CPU display unchanged\n");
+		return;
+	}
+	if (gpu_stage < 2) {
+		IOLog("POLARIS GPU: stage %u complete; CP/RedwoodGPU not started, CPU display unchanged\n", gpu_stage);
+		return;
+	}
+	ready = true;
+	IOLog("POLARIS GPU: A630 ready (stage %u)\n", gpu_stage);
+}
+
+void
+polaris_adreno_init(void)
+{
+	uint32_t on = 0, stage = 0, mhz = 0, dump = 1;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("gpu", &on, sizeof(on)) || on == 0 || hw_lock != NULL) {
+		return;
+	}
+	if (PE_parse_boot_argn("gpu_stage", &stage, sizeof(stage)) && stage >= 1) {
+		gpu_stage = stage;
+	}
+	if (PE_parse_boot_argn("gpu_mhz", &mhz, sizeof(mhz)) && mhz >= 200 && mhz <= 710) {
+		core_mhz = mhz;
+	}
+	if (PE_parse_boot_argn("polarisgpu_dump", &dump, sizeof(dump))) {
+		gpu_dump = dump != 0;
+	}
+	hw_lock = IOLockAlloc();
+	if (hw_lock == NULL) {
+		return;
+	}
+	if (kernel_thread_start(polaris_adreno_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/polaris_fw.c b/bsd/dev/polaris_fw.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris_fw.c
@@ -0,0 +1,165 @@
+/*
+ * polaris: firmware files for drivers, read from the root filesystem once it
+ * is mounted (the GPU's zap shader, SQE microcode and GMU firmware, installed
+ * under /usr/share/firmware/polaris).  If the files are not on the root, the
+ * same blobs are taken from the payload's /chosen/memory-map entries
+ * (GPU-GMU, GPU-SQE, GPU-ZAP-*), which tools/mkpayload.py adds with --blob.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <kern/kalloc.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+int polaris_fw_read(const char *path, void **data, size_t *size);
+void polaris_fw_free(void *data, size_t size);
+int polaris_root_mounted(void);
+
+int
+polaris_root_mounted(void)
+{
+	return rootvnode != NULLVP;
+}
+
+static bool
+polaris_fw_basename_is(const char *path, const char *name)
+{
+	const char *base = path;
+
+	for (const char *p = path; *p != 0; p++) {
+		if (*p == '/') {
+			base = p + 1;
+		}
+	}
+	while (*base != 0 && *name != 0 && *base == *name) {
+		base++;
+		name++;
+	}
+	return *base == 0 && *name == 0;
+}
+
+static const char *
+polaris_fw_adt_name(const char *path)
+{
+	if (polaris_fw_basename_is(path, "a630_gmu.bin")) {
+		return "GPU-GMU";
+	}
+	if (polaris_fw_basename_is(path, "a630_sqe.fw")) {
+		return "GPU-SQE";
+	}
+	if (polaris_fw_basename_is(path, "a630_zap.mdt")) {
+		return "GPU-ZAP-MDT";
+	}
+	if (polaris_fw_basename_is(path, "a630_zap.b00")) {
+		return "GPU-ZAP-B00";
+	}
+	if (polaris_fw_basename_is(path, "a630_zap.b01")) {
+		return "GPU-ZAP-B01";
+	}
+	if (polaris_fw_basename_is(path, "a630_zap.b02")) {
+		return "GPU-ZAP-B02";
+	}
+	return NULL;
+}
+
+static int
+polaris_fw_adt(const char *path, void **data, size_t *size)
+{
+	const char *name = polaris_fw_adt_name(path);
+	DTEntry mmap;
+	const void *value = NULL;
+	unsigned int length = 0;
+	uint64_t pa, bytes;
+	vm_offset_t va;
+	void *buf;
+
+	if (name == NULL ||
+	    SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess ||
+	    SecureDTGetProperty(mmap, name, &value, &length) != kSuccess ||
+	    value == NULL || length != 16) {
+		return ENOENT;
+	}
+	memcpy(&pa, value, sizeof(pa));
+	memcpy(&bytes, (const uint8_t *)value + sizeof(pa), sizeof(bytes));
+	if (bytes == 0 || bytes > (16 << 20)) {
+		return EFBIG;
+	}
+	va = ml_io_map((vm_offset_t)pa, (vm_size_t)bytes);
+	if (va == 0) {
+		return ENOMEM;
+	}
+	buf = kalloc_data((vm_size_t)bytes, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	memcpy(buf, (const void *)va, (size_t)bytes);
+	*data = buf;
+	*size = (size_t)bytes;
+	return 0;
+}
+
+int
+polaris_fw_read(const char *path, void **data, size_t *size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t len = 0;
+	int resid = 0, err;
+	void *buf;
+
+	*data = NULL;
+	*size = 0;
+	if (rootvnode == NULLVP) {
+		return polaris_fw_adt(path, data, size);
+	}
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err) {
+		return polaris_fw_adt(path, data, size);
+	}
+	err = vnode_size(vp, &len, ctx);
+	if (!err && (len <= 0 || len > (16 << 20))) {
+		err = EFBIG;
+	}
+	if (!err) {
+		buf = kalloc_data((vm_size_t)len, Z_WAITOK | Z_ZERO);
+		if (buf == NULL) {
+			err = ENOMEM;
+		} else {
+			err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, 0, UIO_SYSSPACE, IO_NODELOCKED,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid != 0) {
+				err = EIO;
+			}
+			if (err) {
+				kfree_data(buf, (vm_size_t)len);
+			} else {
+				*data = buf;
+				*size = (size_t)len;
+			}
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	if (err) {
+		return polaris_fw_adt(path, data, size);
+	}
+	return 0;
+}
+
+void
+polaris_fw_free(void *data, size_t size)
+{
+	if (data != NULL) {
+		kfree_data(data, size);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
